<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <include
        android:id="@+id/includeHeader"
        layout="@layout/view_header" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E6E8EC" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pedidos"
                android:textColor="#172033"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Acompanhe e atualize o status dos pedidos."
                android:textColor="#7C8492"
                android:textSize="13sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_chip_active"
                        android:gravity="center"
                        android:paddingHorizontal="20dp"
                        android:text="Todos"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_inactive"
                        android:gravity="center"
                        android:paddingHorizontal="20dp"
                        android:text="Pendentes"
                        android:textColor="#172033"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_inactive"
                        android:gravity="center"
                        android:paddingHorizontal="20dp"
                        android:text="Em preparo"
                        android:textColor="#172033"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_inactive"
                        android:gravity="center"
                        android:paddingHorizontal="20dp"
                        android:text="Entregues"
                        android:textColor="#172033"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </HorizontalScrollView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#E2E5EA"
                app:strokeWidth="1dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/txtOrderId1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="#00023"
                        android:textColor="#172033"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtOrderInfo1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/txtOrderId1"
                        android:layout_marginTop="4dp"
                        android:text="Hoje • 12:42 • quarto 101"
                        android:textColor="#7C8492"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txtOrderPrice1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/txtOrderInfo1"
                        android:layout_marginTop="12dp"
                        android:text="R$ 29,90"
                        android:textColor="#172033"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="#7C8492" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignBottom="@id/txtOrderPrice1"
                        android:background="@drawable/bg_status_pending"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="Pendente"
                        android:textColor="#B25E00"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#E2E5EA"
                app:strokeWidth="1dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/txtOrderId2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="#00022"
                        android:textColor="#172033"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtOrderInfo2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/txtOrderId2"
                        android:layout_marginTop="4dp"
                        android:text="Hoje • 12:35 • quarto 102"
                        android:textColor="#7C8492"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txtOrderPrice2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/txtOrderInfo2"
                        android:layout_marginTop="12dp"
                        android:text="R$ 29,90"
                        android:textColor="#172033"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="#7C8492" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignBottom="@id/txtOrderPrice2"
                        android:background="@drawable/bg_status_preparing"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="Em preparo"
                        android:textColor="#2F6BFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#E2E5EA"
                app:strokeWidth="1dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/txtOrderId3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="#00021"
                        android:textColor="#172033"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtOrderInfo3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/txtOrderId3"
                        android:layout_marginTop="4dp"
                        android:text="Hoje • 12:20 • quarto 103"
                        android:textColor="#7C8492"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txtOrderPrice3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/txtOrderInfo3"
                        android:layout_marginTop="12dp"
                        android:text="R$ 29,90"
                        android:textColor="#172033"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="#7C8492" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignBottom="@id/txtOrderPrice3"
                        android:background="@drawable/bg_status_delivered"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="Entregue"
                        android:textColor="#00A859"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1–3 de 98 pedidos hoje"
                    android:textColor="#7C8492"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_chip_inactive"
                        android:gravity="center"
                        android:text="«"
                        android:textColor="#7C8492"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_chip_inactive"
                        android:gravity="center"
                        android:text="‹"
                        android:textColor="#7C8492"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_chip_active"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_chip_inactive"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="#172033"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_chip_inactive"
                        android:gravity="center"
                        android:text="›"
                        android:textColor="#7C8492"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_chip_inactive"
                        android:gravity="center"
                        android:text="»"
                        android:textColor="#7C8492"
                        android:textSize="14sp" />

                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="#F8F9FA"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#E2E5EA"
                app:strokeWidth="1dp"/>

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/includeFooter"
        layout="@layout/view_footer" />

</LinearLayout>