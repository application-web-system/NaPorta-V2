<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <include
        android:id="@+id/includeHeader"
        layout="@layout/view_header_admin" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E6E8EC" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Categorias"
                android:textColor="#172033"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Gerencie as categorias do cardápio."
                android:textColor="#7C8492"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNovaCategoria"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#2F6BFF"
                android:text="+  Nova categoria"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#2F6BFF"
                app:cornerRadius="14dp"
                app:elevation="0dp" />

            <!-- CARD CATEGORIA 1 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true"
                app:strokeWidth="0dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/txtCatId1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="#00001"
                        android:textColor="#7C8492"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/txtCatName1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/txtCatId1"
                        android:layout_marginTop="2dp"
                        android:text="Pratos Principais"
                        android:textColor="#172033"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtCatCount1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/txtCatName1"
                        android:layout_marginTop="4dp"
                        android:text="8 itens"
                        android:textColor="#7C8492"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentTop="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_edit"
                            app:tint="#2F6BFF" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="14dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_remove"
                            app:tint="#FF3B30" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignBottom="@id/txtCatCount1"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_status_active"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="Ativa"
                        android:textColor="#00A859"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CARD CATEGORIA 2 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true"
                app:strokeWidth="0dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/txtCatId2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="#00002"
                        android:textColor="#7C8492"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/txtCatName2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/txtCatId2"
                        android:layout_marginTop="2dp"
                        android:text="Bebidas"
                        android:textColor="#172033"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtCatCount2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/txtCatName2"
                        android:layout_marginTop="4dp"
                        android:text="5 itens"
                        android:textColor="#7C8492"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentTop="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_edit"
                            app:tint="#2F6BFF" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="14dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_remove"
                            app:tint="#FF3B30" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignBottom="@id/txtCatCount2"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_status_active"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="Ativa"
                        android:textColor="#00A859"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CARD CATEGORIA 3 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true"
                app:strokeWidth="0dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/txtCatId3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="#00003"
                        android:textColor="#7C8492"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/txtCatName3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/txtCatId3"
                        android:layout_marginTop="2dp"
                        android:text="Sobremesas"
                        android:textColor="#172033"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtCatCount3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/txtCatName3"
                        android:layout_marginTop="4dp"
                        android:text="3 itens"
                        android:textColor="#7C8492"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentTop="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_edit"
                            app:tint="#2F6BFF" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="14dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_remove"
                            app:tint="#FF3B30" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignBottom="@id/txtCatCount3"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_status_inactive"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="Inativa"
                        android:textColor="#7C8492"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- PAGINAÇÃO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1–3 de 6 categorias"
                    android:textColor="#7C8492"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_chip_inactive"
                        android:gravity="center"
                        android:text="«"
                        android:textColor="#7C8492"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_chip_inactive"
                        android:gravity="center"
                        android:text="‹"
                        android:textColor="#7C8492"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_chip_active"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_chip_inactive"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="#172033"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_chip_inactive"
                        android:gravity="center"
                        android:text="›"
                        android:textColor="#7C8492"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_chip_inactive"
                        android:gravity="center"
                        android:text="»"
                        android:textColor="#7C8492"
                        android:textSize="14sp" />

                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/includeFooter"
        layout="@layout/view_footer" />

</LinearLayout>
