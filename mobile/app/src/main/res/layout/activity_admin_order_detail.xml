<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <!-- LOGO -->
        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_logo">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:src="@drawable/ic_hotel"
                android:contentDescription="@null"
                app:tint="#FFFFFF" />

        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="NAPORTA"
            android:textColor="#172033"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- QUARTO -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/bg_room">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUARTO"
                android:textColor="#737C8C"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="102"
                android:textColor="#172033"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- DIVISÓRIA -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E5E7EB" />

    <!-- CONTEÚDO -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="26dp"
            android:paddingBottom="26dp">

            <!-- IDENTIFICAÇÃO DO PEDIDO -->
            <TextView
                android:id="@+id/txtNumeroPedido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pedido #00001"
                android:textColor="#172033"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDataPedido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Hoje • 12:42 • Hotel Aurora"
                android:textColor="#737C8C"
                android:textSize="13sp" />

            <!-- INFORMAÇÕES DO PEDIDO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:orientation="vertical"
                android:padding="15dp"
                android:background="@drawable/bg_admin_order_card">

                <!-- TÍTULO E STATUS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Informações do pedido"
                        android:textColor="#172033"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- STATUS PENDENTE -->
                    <TextView
                        android:id="@+id/txtStatusPedido"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:background="@drawable/bg_status_pending_admin"
                        android:text="Pendente"
                        android:textColor="#F59E0B"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- HÓSPEDE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Hóspede"
                        android:textColor="#737C8C"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtHospede"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Henrique Maximo"
                        android:textColor="#172033"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- QUARTO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Quarto"
                        android:textColor="#737C8C"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtQuarto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="101"
                        android:textColor="#172033"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- PAGAMENTO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Pagamento"
                        android:textColor="#737C8C"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtPagamento"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cobrar no quarto"
                        android:textColor="#172033"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- ITENS DO PEDIDO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Itens do pedido"
                android:textColor="#172033"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- CARD DO PRODUTO -->
            <LinearLayout
                android:id="@+id/cardItemPedido"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="@drawable/bg_admin_order_card">

                <!-- FOTO -->
                <androidx.cardview.widget.CardView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    app:cardCornerRadius="9dp"
                    app:cardElevation="0dp"
                    app:cardUseCompatPadding="false">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/img_file_mignon"
                        android:scaleType="centerCrop"
                        android:contentDescription="Foto do produto" />

                </androidx.cardview.widget.CardView>

                <!-- INFORMAÇÕES -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtNomeProduto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Almoço"
                        android:textColor="#172033"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtQuantidadeProduto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="1 unidade"
                        android:textColor="#737C8C"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- PREÇO -->
                <TextView
                    android:id="@+id/txtPrecoProduto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R$ 29,90"
                    android:textColor="#172033"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- TOTAL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <TextView
                    android:layout_width="268dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Total do pedido"
                    android:textColor="#737C8C"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtTotalPedido"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R$ 29,90"
                    android:textColor="#172033"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- OBSERVAÇÕES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/bg_admin_observations">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Observações"
                    android:textColor="#172033"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtObservacoes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Sem cebola, por favor."
                    android:textColor="#737C8C"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- ATUALIZAR STATUS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Atualizar status"
                android:textColor="#172033"
                android:textSize="13sp" />

            <!-- SELECT STATUS -->
            <LinearLayout
                android:id="@+id/btnSelecionarStatus"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_admin_select"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/txtStatusSelecionado"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Em preparo"
                    android:textColor="#172033"
                    android:textSize="16sp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_down"
                    android:contentDescription="@null" />

            </LinearLayout>

            <!-- ESPAÇAMENTO -->
            <View
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <!-- BOTÃO ATUALIZAR -->
            <TextView
                android:id="@+id/btnAtualizarPedido"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_primary_button"
                android:gravity="center"
                android:text="Atualizar pedido"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <!-- CANCELAR PEDIDO -->
            <TextView
                android:id="@+id/btnCancelarPedido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Cancelar pedido"
                android:textColor="#FF2020"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
