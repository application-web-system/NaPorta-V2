<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <include
        android:id="@+id/includeHeader"
        layout="@layout/view_header" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E8EAF0" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            android:paddingTop="60dp"
            android:paddingBottom="32dp">

            <FrameLayout
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:background="@drawable/bg_cancel_outer"
                android:layout_gravity="center_horizontal">

                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_cancel_inner">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_cancel_status"
                        android:contentDescription="Pedido cancelado" />

                </FrameLayout>

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Pedido cancelado"
                android:textColor="#171D2B"
                android:textSize="23sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="O pedido foi cancelado com sucesso.\nNenhum valor será cobrado."
                android:textColor="#737C8C"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />

            <FrameLayout
                android:id="@+id/btnVoltarCardapio"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="132dp"
                android:background="@drawable/bg_button"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="VOLTAR AO CARDÁPIO"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </FrameLayout>

        </LinearLayout>

    </ScrollView>

    <include
        android:id="@+id/includeFooter"
        layout="@layout/view_footer" />

</LinearLayout>
